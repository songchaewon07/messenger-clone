rules_version = '2';

// Firebase 콘솔 > Firestore Database > 규칙(Rules) 탭에 이 내용을 붙여넣고 게시(Publish)하세요.
// 기본 규칙은 모든 읽기/쓰기를 막아버려서, 이걸 설정하지 않으면
// "Missing or insufficient permissions" 에러가 나며 앱이 동작하지 않습니다.
// (이것도 흔한 트러블슈팅 포인트 중 하나예요.)

service cloud.firestore {
  match /databases/{database}/documents {

    // users: 로그인한 사람이면 누구나 목록을 읽을 수 있어야
    // "새 대화 시작" 화면에서 대화 상대를 검색/선택할 수 있음.
    // 단, 본인 문서만 쓸 수 있게 제한.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // chats: 대화 참여자만 읽고 쓸 수 있음.
    match /chats/{chatId} {
      allow read, write: if request.auth != null
        && request.auth.uid in resource.data.participants;

      // 채팅방을 새로 만드는 시점에는 resource.data가 아직 없기 때문에
      // request.resource.data 쪽을 검사해야 함.
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }
  }
}
